# triageQ hosted web build — copy to .env and fill in. Never commit .env.

# ── Required ────────────────────────────────────────────────────────────────
# The public hostname. Its DNS A record must point at the server.
TRIAGEQ_DOMAIN=triageq.example.com
# Sent to Unpaywall / OpenAlex with PDF lookups (Unpaywall requires one).
TRIAGEQ_CONTACT_EMAIL=you@example.com

# ── Hosted "demo" keys (optional) ───────────────────────────────────────────
# Leave a key blank and that provider is simply not offered as a demo option.
# ALSO set a monthly spending limit in each provider's console — the caps
# below are a courtesy limit, the console limit is the real ceiling.
TRIAGEQ_HOSTED_ANTHROPIC_KEY=
TRIAGEQ_HOSTED_ANTHROPIC_MODEL=claude-sonnet-5
TRIAGEQ_HOSTED_OPENAI_KEY=
# Required if the OpenAI key is set (no default on purpose).
TRIAGEQ_HOSTED_OPENAI_MODEL=
# Model calls per day on the demo keys: everyone combined / per visitor.
TRIAGEQ_HOSTED_DAILY_TOTAL=100
TRIAGEQ_HOSTED_DAILY_PER_VISITOR=5

# ── Limits (defaults shown) ─────────────────────────────────────────────────
TRIAGEQ_MAX_BATCH_ROWS=50
TRIAGEQ_MAX_UPLOAD_MB=25
TRIAGEQ_MAX_WORKSPACE_MB=100
# Screenings running at once across the whole server; the rest queue.
TRIAGEQ_MAX_CONCURRENT_JOBS=3
# Workspaces unused for this long are deleted.
TRIAGEQ_WORKSPACE_TTL_HOURS=24
# Uploads are refused when free disk drops below this percentage.
TRIAGEQ_MIN_FREE_DISK_PCT=15
# Allow visitors to use their own OpenAI-compatible endpoint (true/false).
TRIAGEQ_ALLOW_CUSTOM_ENDPOINT=true
