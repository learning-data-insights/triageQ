# Caddy obtains and renews the HTTPS certificate for this domain by itself,
# as long as the domain's DNS points at this server and ports 80/443 are open.
{$TRIAGEQ_DOMAIN} {
	encode gzip
	request_body {
		max_size 60MB
	}
	# Access log (John, 2026-10-22: "can you do that all the time?"). JSON, one
	# file per day in the caddy-data volume, kept 30 days (LDI's retention policy;
	# the log holds IP addresses). scripts/usage_report.py turns it into counts.
	log {
		output file /data/access.log {
			roll_interval 24h
			roll_keep 31
			roll_keep_for 720h
		}
	}
	reverse_proxy app:8501
}
